  id                    String                 @id @default(uuid()) @db.Uuid
  companyId             String                 @db.Uuid
  relatedType           CrmActivityRelatedType
  leadId                String?                @db.Uuid
  crmCompanyId          String?                @db.Uuid
  crmContactId          String?                @db.Uuid
  opportunityId         String?                @db.Uuid
  type                  CrmActivityType
  subject               String                 @db.VarChar(255)
  description           String?                @db.Text
  status                CrmActivityStatus      @default(PLANNED)
  priority              CrmActivityPriority    @default(MEDIUM)
  assignedToId          String                 @db.Uuid
  startAt               DateTime?              @db.Timestamptz(3)
  endAt                 DateTime?              @db.Timestamptz(3)
  dueDate               DateTime?              @db.Timestamptz(3)
  completedAt           DateTime?              @db.Timestamptz(3)
  location              String?                @db.VarChar(500)
  participants          String?                @db.VarChar(1000)
  contactPhone          String?                @db.VarChar(32)
  callDurationMinutes   Int?
  emailTo               String?                @db.VarChar(500)
  emailCc               String?                @db.VarChar(500)
  purpose               String?                @db.Text
  observations          String?                @db.Text
  outcome               String?                @db.Text
  nextAction            String?                @db.VarChar(1000)
  nextFollowUpDate      DateTime?              @db.Timestamptz(3)
  reminderMinutesBefore Int?
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(3)
  createdBy             String?                @db.Uuid
  updatedBy             String?                @db.Uuid
  deletedAt             DateTime?              @db.Timestamptz(3)

  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  lead        Lead?                   @relation(fields: [leadId, companyId], references: [id, companyId], onDelete: Restrict)
  crmCompany  CrmCompany?             @relation(fields: [crmCompanyId, companyId], references: [id, companyId], onDelete: Restrict)
  crmContact  CrmContact?             @relation(fields: [crmContactId, companyId], references: [id, companyId], onDelete: Restrict)
  opportunity Opportunity?            @relation(fields: [opportunityId, companyId], references: [id, companyId], onDelete: Restrict)
  assignedTo  CompanyMembership       @relation("CrmActivityAssignee", fields: [assignedToId, companyId], references: [id, companyId], onDelete: Restrict)
  attachments CrmActivityAttachment[]

  @@unique([id, companyId])
  @@index([companyId, relatedType, leadId, deletedAt])
  @@index([companyId, relatedType, crmCompanyId, deletedAt])
  @@index([companyId, relatedType, crmContactId, deletedAt])
  @@index([companyId, relatedType, opportunityId, deletedAt])
  @@index([companyId, assignedToId, status, deletedAt])
  @@index([companyId, status, dueDate, deletedAt])
  @@index([companyId, nextFollowUpDate, deletedAt])
  @@index([companyId, type, deletedAt])
  @@index([companyId, createdBy, deletedAt])
  @@map("crm_activities")
}

model CrmActivityAttachment {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  activityId  String    @db.Uuid
  fileId      String    @db.Uuid
  title       String?   @db.VarChar(255)
  description String?   @db.VarChar(500)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  createdBy   String?   @db.Uuid
  updatedBy   String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(3)

  company  Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  activity CrmActivity @relation(fields: [activityId, companyId], references: [id, companyId], onDelete: Restrict)
  file     FileObject  @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([activityId, fileId])
  @@index([companyId, activityId, deletedAt, createdAt])
  @@map("crm_activity_attachments")
}

model OpportunityNote {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  opportunityId String    @db.Uuid
  note          String    @db.Text
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  createdBy     String?   @db.Uuid
  updatedBy     String?   @db.Uuid
  deletedAt     DateTime? @db.Timestamptz(3)

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  opportunity Opportunity @relation(fields: [opportunityId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, opportunityId, deletedAt, createdAt])
  @@map("opportunity_notes")
}

model OpportunityAttachment {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  opportunityId String    @db.Uuid
  fileId        String    @db.Uuid
  title         String?   @db.VarChar(255)
  description   String?   @db.VarChar(500)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  createdBy     String?   @db.Uuid
  updatedBy     String?   @db.Uuid
  deletedAt     DateTime? @db.Timestamptz(3)

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  opportunity Opportunity @relation(fields: [opportunityId, companyId], references: [id, companyId], onDelete: Restrict)
  file        FileObject  @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([opportunityId, fileId])
  @@index([companyId, opportunityId, deletedAt, createdAt])
  @@map("opportunity_attachments")
}

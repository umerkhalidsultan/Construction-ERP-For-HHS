model ProjectMilestone {
  id                   String          @id @default(uuid()) @db.Uuid
  companyId            String          @db.Uuid
  projectId            String          @db.Uuid
  phaseId              String?         @db.Uuid
  activityId           String?         @unique @db.Uuid
  name                 String          @db.VarChar(200)
  description          String?         @db.VarChar(2000)
  targetDate           DateTime        @db.Date
  actualDate           DateTime?       @db.Date
  status               MilestoneStatus @default(PENDING)
  weightage            Decimal         @default(0) @db.Decimal(5, 2)
  completionPercentage Decimal         @default(0) @db.Decimal(5, 2)
  createdAt            DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(3)
  createdBy            String?         @db.Uuid
  updatedBy            String?         @db.Uuid
  deletedAt            DateTime?       @db.Timestamptz(3)

  project          Project @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Restrict)
  phase            ProjectPhase? @relation(fields: [phaseId, companyId], references: [id, companyId], onDelete: Restrict)
  activity         ProjectTask? @relation(fields: [activityId], references: [id], onDelete: Restrict)
  dependsOn        ProjectMilestoneDependency[] @relation("MilestoneDependent")
  dependencyOf     ProjectMilestoneDependency[] @relation("MilestonePrerequisite")
  calendarEvents   ProjectCalendarEvent[]

  @@unique([id, companyId])
  @@index([companyId, projectId, targetDate, deletedAt])
  @@map("project_milestones")
}

model ProjectMilestoneDependency {

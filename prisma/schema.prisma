  stageHistory  OpportunityStageHistory[] @relation("ToStage")
  priorHistory  OpportunityStageHistory[] @relation("FromStage")

  @@unique([id, companyId])
  @@index([companyId, code, deletedAt])
  @@map("opportunity_stage_definitions")
}


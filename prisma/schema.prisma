model Company {
  id                    String             @id @default(uuid()) @db.Uuid
  companyCode           String             @db.VarChar(32)
  legalName             String             @db.VarChar(255)
  displayName           String             @db.VarChar(160)
  logo                  String?            @db.VarChar(2048)
  email                 String?            @db.VarChar(320)
  phone                 String?            @db.VarChar(32)
  website               String?            @db.VarChar(2048)
  industry              String?            @db.VarChar(120)
  companyType           CompanyType        @default(PRIVATE)
  taxRegistrationNumber String?            @db.VarChar(100)
  nationalTaxNumber     String?            @db.VarChar(100)
  registrationNumber    String?            @db.VarChar(100)
  currency              String             @default("USD") @db.Char(3)
  timezone              String             @default("UTC") @db.VarChar(64)
  country               String             @db.Char(2)
  province              String?            @db.VarChar(120)
  city                  String?            @db.VarChar(120)
  postalCode            String?            @db.VarChar(32)
  address               String?            @db.VarChar(500)
  status                CompanyStatus      @default(ACTIVE)
  subscriptionStatus    SubscriptionStatus @default(TRIAL)
  subscriptionPlan      String?            @db.VarChar(80)
  employeeLimit         Int?
  projectLimit          Int?
  storageLimit          BigInt?            @db.BigInt
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3)
  createdBy             String?            @db.Uuid
  updatedBy             String?            @db.Uuid
  deletedAt             DateTime?          @db.Timestamptz(3)

  settings                  CompanySettings?
  branding                  CompanyBranding?
  memberships               CompanyMembership[]
  roles                     Role[]
  branches                  Branch[]
  departments               Department[]
  designations              Designation[]
  businessUnits             BusinessUnit[]
  regions                   Region[]
  costCenters               CostCenter[]
  teams                     Team[]
  reportingLines            ReportingLine[]
  documentSequences         DocumentSequence[]
  files                     FileObject[]
  auditLogs                 AuditLog[]
  projects                  Project[]
  projectStatusDefinitions  ProjectStatusDefinition[]
  projectTypeDefinitions    ProjectTypeDefinition[]
  projectTags               ProjectTag[]
  employees                 Employee[]
  employmentTypes           EmploymentType[]
  workforceSkills           WorkforceSkill[]
  qualityStandards          QualityStandard[]
  qualityPlans              QualityPlan[]
  qualityItps               QualityItp[]
  qualityInspections        QualityInspection[]
  qualityChecklistTemplates QualityChecklistTemplate[]
  qualityTestDefinitions    QualityTestDefinition[]
  qualityTestResults        QualityTestResult[]
  qualityNcrs               QualityNcr[]
  qualityActions            QualityCorrectiveAction[]
  qualityIssues             QualityIssue[]
  qualityReworks            QualityRework[]
  qualityOutboxEvents       QualityOutboxEvent[]
  qualitySubmittals         QualitySubmittal[]
  qualitySamples            QualitySample[]
  leadTypes                 LeadTypeDefinition[]
  leadSources               LeadSourceDefinition[]
  leads                     Lead[]
  leadNotes                 LeadNote[]
  leadAttachments           LeadAttachment[]
  crmCompanies              CrmCompany[]
  crmContacts               CrmContact[]
  crmCompanyTypes           CrmCompanyTypeDefinition[]
  crmContactTypes           CrmContactTypeDefinition[]
  crmCompanyNotes           CrmCompanyNote[]
  crmContactNotes           CrmContactNote[]
  crmCompanyAttachments     CrmCompanyAttachment[]
  crmContactAttachments     CrmContactAttachment[]
  opportunityStages         OpportunityStageDefinition[]
  opportunityTypes          OpportunityTypeDefinition[]
  opportunitySources        OpportunitySourceDefinition[]
  opportunityLostReasons    OpportunityLostReasonDefinition[]
  opportunities             Opportunity[]
  opportunityStageHistory   OpportunityStageHistory[]
  opportunityNotes          OpportunityNote[]
  opportunityAttachments    OpportunityAttachment[]
  crmActivities             CrmActivity[]
  crmActivityAttachments    CrmActivityAttachment[]
  tenders                   Tender[]

  @@index([status, deletedAt])
  @@index([displayName])
  @@map("companies")
}

// -----------------------------------------------------------------------------
// TENDER MANAGEMENT FOUNDATION
// -----------------------------------------------------------------------------

enum TenderStatus {
  DRAFT
  REGISTERED
  UNDER_REVIEW
  BID_DECISION_PENDING
  BID_APPROVED
  NO_BID
  PREPARING
  READY_FOR_SUBMISSION
  SUBMITTED
  CLARIFICATION
  TECHNICAL_EVALUATION
  COMMERCIAL_EVALUATION
  NEGOTIATION
  AWARDED
  LOST
  CANCELLED
}

enum TenderPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
  CRITICAL
}

enum TenderRequirementStatus {
  NOT_STARTED
  IN_PROGRESS
  READY
  VERIFIED
  NOT_APPLICABLE
  BLOCKED
}

enum TenderBidDecisionType {
  BID
  NO_BID
}

enum TenderSubmissionMethod {
  ONLINE_PORTAL
  EMAIL
  PHYSICAL
  COURIER
  OTHER
}

enum TenderEstimateStatus {
  DRAFT
  IN_PROGRESS
  UNDER_REVIEW
  APPROVED
  SUPERSEDED
  ARCHIVED
}

enum TenderEstimateResourceType {
  MATERIAL
  LABOR
  EQUIPMENT
  SUBCONTRACT
  OTHER
}

enum TenderPricingStatus {
  DRAFT
  IN_PROGRESS
  UNDER_REVIEW
  APPROVED
  SUPERSEDED
  ARCHIVED
}

enum TenderPricingBasis {
  FIXED_AMOUNT
  PERCENT_OF_DIRECT_COST
  QUANTITY_X_RATE
}

model Tender {
  id                        String                @id @default(uuid()) @db.Uuid
  companyId                 String                @db.Uuid
  tenderNumber              String                @db.VarChar(50)
  title                     String                @db.VarChar(255)
  internalReference         String?               @db.VarChar(100)
  opportunityId             String?               @db.Uuid
  clientCompanyId           String                @db.Uuid
  primaryContactId          String?               @db.Uuid
  consultantCompanyId       String?               @db.Uuid
  architectCompanyId        String?               @db.Uuid
  tenderType                String                @db.VarChar(100)
  projectType               String?               @db.VarChar(120)
  projectLocation           String?               @db.VarChar(500)
  city                      String?               @db.VarChar(120)
  issueDate                 DateTime?             @db.Date
  closingDate               DateTime              @db.Timestamptz(3)
  clarificationDeadline     DateTime?             @db.Timestamptz(3)
  openingDate               DateTime?             @db.Timestamptz(3)
  expectedAwardDate         DateTime?             @db.Date
  estimatedValue            Decimal?              @db.Decimal(18, 2)
  awardedValue              Decimal?              @db.Decimal(18, 2)
  currency                  String                @db.Char(3)
  tenderManagerMembershipId String?               @db.Uuid
  teamId                    String?               @db.Uuid
  priority                  TenderPriority        @default(MEDIUM)
  status                    TenderStatus          @default(DRAFT)
  description               String?               @db.Text
  scopeSummary              String?               @db.Text
  awardDate                 DateTime?             @db.Date
  awardReference            String?               @db.VarChar(160)
  awardNotes                String?               @db.Text
  lostDate                  DateTime?             @db.Date
  lostReason                String?               @db.VarChar(1000)
  lostNotes                 String?               @db.Text
  competitorCompanyId       String?               @db.Uuid
  cancellationReason        String?               @db.VarChar(1000)
  createdAt                 DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime              @updatedAt @db.Timestamptz(3)
  createdBy                 String?               @db.Uuid
  updatedBy                 String?               @db.Uuid
  deletedAt                 DateTime?             @db.Timestamptz(3)
  company                   Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  opportunity               Opportunity?          @relation(fields: [opportunityId, companyId], references: [id, companyId], onDelete: Restrict)
  clientCompany             CrmCompany            @relation("TenderClient", fields: [clientCompanyId, companyId], references: [id, companyId], onDelete: Restrict)
  primaryContact            CrmContact?           @relation(fields: [primaryContactId, companyId], references: [id, companyId], onDelete: Restrict)
  consultant                CrmCompany?           @relation("TenderConsultant", fields: [consultantCompanyId, companyId], references: [id, companyId], onDelete: Restrict)
  architect                 CrmCompany?           @relation("TenderArchitect", fields: [architectCompanyId, companyId], references: [id, companyId], onDelete: Restrict)
  competitor                CrmCompany?           @relation("TenderCompetitor", fields: [competitorCompanyId, companyId], references: [id, companyId], onDelete: Restrict)
  tenderManager             CompanyMembership?    @relation("TenderManager", fields: [tenderManagerMembershipId, companyId], references: [id, companyId], onDelete: Restrict)
  team                      Team?                 @relation(fields: [teamId, companyId], references: [id, companyId], onDelete: Restrict)
  teamMembers               TenderTeamMember[]
  requirements              TenderRequirement[]
  bidDecision               TenderBidDecision?
  submissions               TenderSubmission[]
  attachments               TenderAttachment[]
  siteVisits                TenderSiteVisit[]
  preBidMeetings            TenderPreBidMeeting[]
  estimates                 TenderEstimate[]
  pricings                  TenderPricing[]

  @@unique([companyId, tenderNumber])
  @@unique([id, companyId])
  @@index([companyId, status, deletedAt, closingDate])
  @@index([companyId, tenderManagerMembershipId, deletedAt])
  @@index([companyId, clientCompanyId, deletedAt])
  @@map("tenders")
}

model TenderEstimate {
  id                  String                  @id @default(uuid()) @db.Uuid
  companyId           String                  @db.Uuid
  tenderId            String                  @db.Uuid
  estimateNumber      String                  @db.VarChar(80)
  revision            Int                     @default(0)
  title               String                  @db.VarChar(255)
  description         String?                 @db.Text
  status              TenderEstimateStatus    @default(DRAFT)
  currency            String                  @db.Char(3)
  baseDate            DateTime?               @db.Date
  lockedAt            DateTime?               @db.Timestamptz(3)
  lockedBy            String?                 @db.Uuid
  createdBy           String?                 @db.Uuid
  updatedBy           String?                 @db.Uuid
  createdAt           DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                @updatedAt @db.Timestamptz(3)
  deletedAt           DateTime?               @db.Timestamptz(3)
  tender              Tender                  @relation(fields: [tenderId, companyId], references: [id, companyId], onDelete: Restrict)
  sections            TenderEstimateSection[]
  tenderEstimateItems TenderEstimateItem[]
  pricings            TenderPricing[]

  @@unique([tenderId, revision])
  @@unique([companyId, estimateNumber])
  @@index([companyId, tenderId, status, deletedAt])
  @@map("tender_estimates")
}

model TenderEstimateSection {
  id          String               @id @default(uuid()) @db.Uuid
  companyId   String               @db.Uuid
  estimateId  String               @db.Uuid
  code        String?              @db.VarChar(80)
  title       String               @db.VarChar(255)
  description String?              @db.Text
  sortOrder   Int                  @default(0)
  notes       String?              @db.Text
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?            @db.Timestamptz(3)
  estimate    TenderEstimate       @relation(fields: [estimateId], references: [id], onDelete: Restrict)
  items       TenderEstimateItem[]

  @@index([companyId, estimateId, sortOrder, deletedAt])
  @@map("tender_estimate_sections")
}

model TenderEstimateItem {
  id              String                   @id @default(uuid()) @db.Uuid
  companyId       String                   @db.Uuid
  estimateId      String                   @db.Uuid
  sectionId       String?                  @db.Uuid
  itemNumber      String?                  @db.VarChar(100)
  description     String                   @db.Text
  quantity        Decimal                  @default(0) @db.Decimal(18, 4)
  unit            String?                  @db.VarChar(40)
  materialCost    Decimal                  @default(0) @db.Decimal(18, 4)
  laborCost       Decimal                  @default(0) @db.Decimal(18, 4)
  equipmentCost   Decimal                  @default(0) @db.Decimal(18, 4)
  subcontractCost Decimal                  @default(0) @db.Decimal(18, 4)
  otherCost       Decimal                  @default(0) @db.Decimal(18, 4)
  wastePercent    Decimal                  @default(0) @db.Decimal(8, 4)
  unitDirectCost  Decimal                  @default(0) @db.Decimal(18, 4)
  totalDirectCost Decimal                  @default(0) @db.Decimal(18, 2)
  notes           String?                  @db.Text
  sourceReference String?                  @db.VarChar(255)
  sortOrder       Int                      @default(0)
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime?                @db.Timestamptz(3)
  estimate        TenderEstimate           @relation(fields: [estimateId], references: [id], onDelete: Restrict)
  section         TenderEstimateSection?   @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  resources       TenderEstimateResource[]

  @@unique([estimateId, itemNumber])
  @@index([companyId, estimateId, sectionId, sortOrder, deletedAt])
  @@map("tender_estimate_items")
}

model TenderEstimateResource {
  id                String                     @id @default(uuid()) @db.Uuid
  companyId         String                     @db.Uuid
  itemId            String                     @db.Uuid
  resourceType      TenderEstimateResourceType
  description       String                     @db.VarChar(500)
  quantityPerUnit   Decimal                    @default(0) @db.Decimal(18, 4)
  unit              String?                    @db.VarChar(40)
  unitCost          Decimal                    @default(0) @db.Decimal(18, 4)
  wastePercent      Decimal                    @default(0) @db.Decimal(8, 4)
  totalContribution Decimal                    @default(0) @db.Decimal(18, 4)
  notes             String?                    @db.Text
  createdAt         DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                   @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime?                  @db.Timestamptz(3)
  item              TenderEstimateItem         @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([companyId, itemId, resourceType, deletedAt])
  @@map("tender_estimate_resources")
}

model TenderPricing {
  id                String                      @id @default(uuid()) @db.Uuid
  companyId         String                      @db.Uuid
  tenderId          String                      @db.Uuid
  estimateId        String                      @db.Uuid
  pricingReference  String                      @db.VarChar(80)
  revision          Int                         @default(0)
  title             String                      @db.VarChar(255)
  description       String?                     @db.Text
  status            TenderPricingStatus         @default(DRAFT)
  currency          String                      @db.Char(3)
  baseDirectCost    Decimal                     @default(0) @db.Decimal(18, 2)
  totalIndirectCost Decimal                     @default(0) @db.Decimal(18, 2)
  profitAmount      Decimal                     @default(0) @db.Decimal(18, 2)
  discountAmount    Decimal                     @default(0) @db.Decimal(18, 2)
  taxAmount         Decimal                     @default(0) @db.Decimal(18, 2)
  finalTenderPrice  Decimal                     @default(0) @db.Decimal(18, 2)
  approvedAt        DateTime?                   @db.Timestamptz(3)
  approvedBy        String?                     @db.Uuid
  createdBy         String?                     @db.Uuid
  updatedBy         String?                     @db.Uuid
  createdAt         DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                    @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime?                   @db.Timestamptz(3)
  tender            Tender                      @relation(fields: [tenderId, companyId], references: [id, companyId], onDelete: Restrict)
  estimate          TenderEstimate              @relation(fields: [estimateId], references: [id], onDelete: Restrict)
  indirectCosts     TenderPricingIndirectCost[]

  @@unique([tenderId, revision])
  @@unique([companyId, pricingReference])
  @@index([companyId, tenderId, status, deletedAt])
  @@map("tender_pricings")
}

model TenderPricingIndirectCost {
  id          String             @id @default(uuid()) @db.Uuid
  companyId   String             @db.Uuid
  pricingId   String             @db.Uuid
  category    String             @db.VarChar(100)
  description String             @db.VarChar(500)
  basis       TenderPricingBasis
  quantity    Decimal            @default(0) @db.Decimal(18, 4)
  unitCost    Decimal            @default(0) @db.Decimal(18, 4)
  percentage  Decimal            @default(0) @db.Decimal(8, 4)
  amount      Decimal            @default(0) @db.Decimal(18, 2)
  notes       String?            @db.Text
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?          @db.Timestamptz(3)
  pricing     TenderPricing      @relation(fields: [pricingId], references: [id], onDelete: Restrict)

  @@index([companyId, pricingId, sortOrder, deletedAt])
  @@map("tender_pricing_indirect_costs")
}

model TenderTeamMember {
  id           String    @id @default(uuid()) @db.Uuid

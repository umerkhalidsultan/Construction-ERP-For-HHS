  dependsOn ProjectMilestone @relation("MilestonePrerequisite", fields: [dependsOnMilestoneId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, projectId, deletedAt])
  @@map("project_milestone_dependencies")
}


model Opportunity {
  id                     String              @id @default(uuid()) @db.Uuid
  companyId              String              @db.Uuid
  opportunityNumber      String              @db.VarChar(50)
  name                   String              @db.VarChar(255)
  leadId                 String?             @unique @db.Uuid
  crmCompanyId           String?             @db.Uuid
  crmContactId           String?             @db.Uuid
  opportunityTypeId      String              @db.Uuid
  sourceId               String              @db.Uuid
  stageId                String              @db.Uuid
  status                 OpportunityStatus   @default(OPEN)
  projectLocation        String?             @db.VarChar(500)
  city                   String?             @db.VarChar(120)
  area                   String?             @db.VarChar(160)
  estimatedContractValue Decimal?            @db.Decimal(18, 2)
  currency               String              @db.Char(3)
  probability            Int                 @default(0)
  priority               OpportunityPriority @default(MEDIUM)
  expectedClosingDate    DateTime?           @db.Date
  expectedStartDate      DateTime?           @db.Date
  expectedCompletionDate DateTime?           @db.Date
  assignedToId           String?             @db.Uuid
  description            String?             @db.Text
  wonDate                DateTime?           @db.Date
  finalContractValue     Decimal?            @db.Decimal(18, 2)
  winReason              String?             @db.VarChar(1000)
  competitor             String?             @db.VarChar(255)
  winRemarks             String?             @db.Text
  lostDate               DateTime?           @db.Date
  lostReasonId           String?             @db.Uuid
  lostRemarks            String?             @db.Text
  lastActivityAt         DateTime            @default(now()) @db.Timestamptz(3)
  createdAt              DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @db.Timestamptz(3)
  createdBy              String?             @db.Uuid
  updatedBy              String?             @db.Uuid
  deletedAt              DateTime?           @db.Timestamptz(3)

  company         Company                          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  lead            Lead?                            @relation(fields: [leadId], references: [id], onDelete: Restrict)
  crmCompany      CrmCompany?                      @relation(fields: [crmCompanyId, companyId], references: [id, companyId], onDelete: Restrict)
  crmContact      CrmContact?                      @relation(fields: [crmContactId, companyId], references: [id, companyId], onDelete: Restrict)
  opportunityType OpportunityTypeDefinition        @relation(fields: [opportunityTypeId], references: [id], onDelete: Restrict)
  source          OpportunitySourceDefinition      @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  stage           OpportunityStageDefinition       @relation(fields: [stageId], references: [id], onDelete: Restrict)
  lostReason      OpportunityLostReasonDefinition? @relation(fields: [lostReasonId], references: [id], onDelete: Restrict)
  assignedTo      CompanyMembership?               @relation("OpportunityAssignee", fields: [assignedToId, companyId], references: [id, companyId], onDelete: Restrict)
  stageHistory    OpportunityStageHistory[]
  activities      CrmActivity[]
  notes           OpportunityNote[]
  attachments     OpportunityAttachment[]
  tenders         Tender[]

  @@unique([companyId, opportunityNumber])
  @@unique([id, companyId])
  @@index([companyId, status, deletedAt, createdAt])
  @@index([companyId, stageId, status, deletedAt])
  @@index([companyId, assignedToId, status, deletedAt])
  @@index([companyId, expectedClosingDate, deletedAt])
  @@index([companyId, priority, status, deletedAt])
  @@index([companyId, crmCompanyId, deletedAt])
  @@index([companyId, crmContactId, deletedAt])
  @@index([companyId, opportunityTypeId, deletedAt])
  @@index([companyId, sourceId, deletedAt])
  @@index([companyId, wonDate, deletedAt])
  @@index([companyId, lostDate, deletedAt])
  @@map("opportunities")
}

model OpportunityStageHistory {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  opportunityId String    @db.Uuid
  fromStageId   String?   @db.Uuid
  toStageId     String    @db.Uuid
  changedById   String?   @db.Uuid
  reason        String?   @db.VarChar(1000)
  changedAt     DateTime  @default(now()) @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

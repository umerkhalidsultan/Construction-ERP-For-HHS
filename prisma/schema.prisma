  companyId    String     @db.Uuid
  crmContactId String     @db.Uuid
  fileId       String     @db.Uuid
  title        String?    @db.VarChar(255)
  description  String?    @db.VarChar(500)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
  createdBy    String?    @db.Uuid
  updatedBy    String?    @db.Uuid
  deletedAt    DateTime?  @db.Timestamptz(3)
  tenant       Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  crmContact   CrmContact @relation(fields: [crmContactId, companyId], references: [id, companyId], onDelete: Restrict)
  file         FileObject @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([crmContactId, fileId])
  @@index([companyId, crmContactId, deletedAt, createdAt])
  @@map("crm_contact_attachments")
}

// -----------------------------------------------------------------------------
// PROJECT LIFECYCLE
// -----------------------------------------------------------------------------

model ProjectStatusDefinition {
  id          String                 @id @default(uuid()) @db.Uuid
  companyId   String?                @db.Uuid
  code        String                 @db.VarChar(50)
  name        String                 @db.VarChar(120)
  description String?                @db.VarChar(500)
  lifecycle   ProjectLifecycleStatus
  isSystem    Boolean                @default(false)
  isTerminal  Boolean                @default(false)
  sortOrder   Int                    @default(0)
  color       String?                @db.VarChar(9)
  status      EntityStatus           @default(ACTIVE)
  createdAt   DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime               @updatedAt @db.Timestamptz(3)
  createdBy   String?                @db.Uuid
  updatedBy   String?                @db.Uuid
  deletedAt   DateTime?              @db.Timestamptz(3)

  company  Company?  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  projects Project[]

  @@unique([id, companyId])
  @@index([companyId, code, deletedAt])
  @@map("project_status_definitions")
}

model ProjectTypeDefinition {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String?      @db.Uuid
  code        String       @db.VarChar(50)
  name        String       @db.VarChar(120)
  description String?      @db.VarChar(500)
  isSystem    Boolean      @default(false)
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  createdBy   String?      @db.Uuid
  updatedBy   String?      @db.Uuid
  deletedAt   DateTime?    @db.Timestamptz(3)

  company        Company?  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  projects       Project[]
  constructionOf Project[] @relation("ConstructionType")

  @@unique([id, companyId])
  @@index([companyId, code, deletedAt])
  @@map("project_type_definitions")
}

model Project {
  id                     String                 @id @default(uuid()) @db.Uuid
  companyId              String                 @db.Uuid
  projectCode            String                 @db.VarChar(50)
  projectName            String                 @db.VarChar(255)
  projectShortName       String?                @db.VarChar(80)
  projectTypeId          String                 @db.Uuid
  constructionTypeId     String?                @db.Uuid
  statusId               String                 @db.Uuid
  lifecycleStatus        ProjectLifecycleStatus @default(DRAFT)
  priority               ProjectPriority        @default(MEDIUM)
  clientId               String?                @db.Uuid
  consultantId           String?                @db.Uuid
  architectId            String?                @db.Uuid
  projectManagerId       String                 @db.Uuid
  siteEngineerId         String?                @db.Uuid
  branchId               String?                @db.Uuid
  departmentId           String?                @db.Uuid
  estimatedBudget        Decimal                @db.Decimal(18, 2)
  approvedBudget         Decimal?               @db.Decimal(18, 2)
  estimatedCost          Decimal?               @db.Decimal(18, 2)
  contractValue          Decimal?               @db.Decimal(18, 2)
  currency               String                 @db.Char(3)
  contractType           ProjectContractType    @default(LUMP_SUM)
  contractNumber         String?                @db.VarChar(100)
  projectStartDate       DateTime               @db.Date
  plannedCompletionDate  DateTime               @db.Date
  actualCompletionDate   DateTime?              @db.Date
  defectLiabilityEndDate DateTime?              @db.Date
  latitude               Decimal?               @db.Decimal(10, 7)
  longitude              Decimal?               @db.Decimal(10, 7)
  address                String?                @db.VarChar(500)
  area                   String?                @db.VarChar(160)
  city                   String?                @db.VarChar(120)
  province               String?                @db.VarChar(120)
  country                String                 @db.Char(2)
  projectDescription     String?                @db.Text
  scopeOfWork            String?                @db.Text
  remarks                String?                @db.Text
  completionPercentage   Decimal                @default(0) @db.Decimal(5, 2)
  createdAt              DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime               @updatedAt @db.Timestamptz(3)
  createdBy              String?                @db.Uuid
  updatedBy              String?                @db.Uuid
  deletedAt              DateTime?              @db.Timestamptz(3)

  company                   Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  projectType               ProjectTypeDefinition       @relation(fields: [projectTypeId], references: [id], onDelete: Restrict)
  constructionType          ProjectTypeDefinition?      @relation("ConstructionType", fields: [constructionTypeId], references: [id], onDelete: Restrict)
  status                    ProjectStatusDefinition     @relation(fields: [statusId], references: [id], onDelete: Restrict)
  projectManager            CompanyMembership           @relation("ProjectManager", fields: [projectManagerId, companyId], references: [id, companyId], onDelete: Restrict)
  siteEngineer              CompanyMembership?          @relation("ProjectSiteEngineer", fields: [siteEngineerId, companyId], references: [id, companyId], onDelete: Restrict)
  branch                    Branch?                     @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
  department                Department?                 @relation(fields: [departmentId, companyId], references: [id, companyId], onDelete: Restrict)
  settings                  ProjectSettings?
  phases                    ProjectPhase[]
  milestones                ProjectMilestone[]
  teamMembers               ProjectTeamMember[]
  documents                 ProjectDocument[]
  calendarEvents            ProjectCalendarEvent[]
  tagAssignments            ProjectTagAssignment[]
  wbsNodes                  ProjectWbs[]
  planningBaselines         ProjectBaseline[]
  employeeAssignments       EmployeeProjectAssignment[]
  qualityPlans              QualityPlan[]
  qualityItps               QualityItp[]
  qualityInspections        QualityInspection[]
  qualityChecklistTemplates QualityChecklistTemplate[]
  qualityTestDefinitions    QualityTestDefinition[]
  qualityTestResults        QualityTestResult[]
  qualityNcrs               QualityNcr[]
  qualityActions            QualityCorrectiveAction[]
  qualityIssues             QualityIssue[]
  qualityReworks            QualityRework[]
  qualityOutboxEvents       QualityOutboxEvent[]
  qualitySubmittals         QualitySubmittal[]
  qualitySamples            QualitySample[]

  @@unique([id, companyId])
  @@index([companyId, lifecycleStatus, deletedAt])
  @@index([companyId, projectName])
  @@index([companyId, projectManagerId])
  @@index([companyId, branchId])
  @@map("projects")
}

model ProjectSettings {
  id                   String    @id @default(uuid()) @db.Uuid
  companyId            String    @db.Uuid
  projectId            String    @unique @db.Uuid
  workingDays          Weekday[] @default([MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY])
  workingHoursStart    String    @default("08:00") @db.VarChar(5)
  workingHoursEnd      String    @default("17:00") @db.VarChar(5)
  timezone             String    @default("UTC") @db.VarChar(64)
  currency             String    @db.Char(3)
  documentPrefix       String?   @db.VarChar(40)
  defaultWarehouseId   String?   @db.Uuid
  defaultStoreId       String?   @db.Uuid
  notificationSettings Json      @default("{}")
  approvalFlow         Json      @default("{}")
  calendarSettings     Json      @default("{}")
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)
  createdBy            String?   @db.Uuid
  updatedBy            String?   @db.Uuid
  deletedAt            DateTime? @db.Timestamptz(3)

  project Project @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([projectId, companyId])
  @@index([companyId, deletedAt])
  @@map("project_settings")
}

model ProjectPhase {
  id                   String      @id @default(uuid()) @db.Uuid
  companyId            String      @db.Uuid
  projectId            String      @db.Uuid
  code                 String      @db.VarChar(50)
  name                 String      @db.VarChar(160)
  description          String?     @db.VarChar(1000)
  sortOrder            Int         @default(0)
  plannedStartDate     DateTime?   @db.Date
  plannedEndDate       DateTime?   @db.Date
  actualStartDate      DateTime?   @db.Date
  actualEndDate        DateTime?   @db.Date
  budget               Decimal?    @db.Decimal(18, 2)
  completionPercentage Decimal     @default(0) @db.Decimal(5, 2)
  status               PhaseStatus @default(NOT_STARTED)
  createdAt            DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @db.Timestamptz(3)
  createdBy            String?     @db.Uuid
  updatedBy            String?     @db.Uuid
  deletedAt            DateTime?   @db.Timestamptz(3)

  project    Project            @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Restrict)
  tasks      ProjectTask[]
  milestones ProjectMilestone[]
  documents  ProjectDocument[]
  wbsNodes   ProjectWbs[]

  @@unique([id, companyId])
  @@index([companyId, projectId, deletedAt])
  @@map("project_phases")
}

model ProjectTask {
  id                     String          @id @default(uuid()) @db.Uuid
  companyId              String          @db.Uuid
  projectId              String          @db.Uuid
  phaseId                String          @db.Uuid
  wbsId                  String?         @db.Uuid
  parentTaskId           String?         @db.Uuid
  activityCode           String?         @db.VarChar(50)
  activityType           ActivityType    @default(TASK)
  name                   String          @db.VarChar(200)
  description            String?         @db.VarChar(2000)
  assigneeMembershipId   String?         @db.Uuid
  plannedStartDate       DateTime?       @db.Date
  plannedEndDate         DateTime?       @db.Date
  durationDays           Int             @default(1)
  remainingDurationDays  Int?
  actualStartDate        DateTime?       @db.Date
  actualEndDate          DateTime?       @db.Date
  completionPercentage   Decimal         @default(0) @db.Decimal(5, 2)
  plannedQuantity        Decimal?        @db.Decimal(18, 4)
  actualQuantity         Decimal?        @db.Decimal(18, 4)
  unit                   String?         @db.VarChar(32)
  supervisorMembershipId String?         @db.Uuid
  priority               ProjectPriority @default(MEDIUM)
  notes                  String?         @db.Text
  isManuallyScheduled    Boolean         @default(false)
  isCritical             Boolean         @default(false)
  earlyStartDate         DateTime?       @db.Date
  earlyFinishDate        DateTime?       @db.Date
  lateStartDate          DateTime?       @db.Date
  lateFinishDate         DateTime?       @db.Date
  totalFloatDays         Int?
  freeFloatDays          Int?
  status                 TaskStatus      @default(TODO)
  sortOrder              Int             @default(0)
  createdAt              DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @db.Timestamptz(3)
  createdBy              String?         @db.Uuid
  updatedBy              String?         @db.Uuid
  deletedAt              DateTime?       @db.Timestamptz(3)

  phase              ProjectPhase         @relation(fields: [phaseId, companyId], references: [id, companyId], onDelete: Restrict)
  assignee           CompanyMembership?   @relation("ProjectTaskAssignee", fields: [assigneeMembershipId, companyId], references: [id, companyId], onDelete: Restrict)
  supervisor         CompanyMembership?   @relation("ProjectTaskSupervisor", fields: [supervisorMembershipId, companyId], references: [id, companyId], onDelete: Restrict)
  wbs                ProjectWbs?          @relation(fields: [wbsId, companyId], references: [id, companyId], onDelete: Restrict)
  parentTask         ProjectTask?         @relation("ProjectTaskHierarchy", fields: [parentTaskId], references: [id], onDelete: Restrict)
  childTasks         ProjectTask[]        @relation("ProjectTaskHierarchy")
  predecessors       ActivityDependency[] @relation("ActivitySuccessor")
  successors         ActivityDependency[] @relation("ActivityPredecessor")
  baselineSnapshots  BaselineActivity[]
  progressEntries    ActivityProgress[]
  scheduleMilestone  ProjectMilestone?
  qualityItps        QualityItp[]
  qualityInspections QualityInspection[]
  qualityTestResults QualityTestResult[]
  qualityNcrs        QualityNcr[]
  qualityIssues      QualityIssue[]
  qualityReworks     QualityRework[]
  qualitySubmittals  QualitySubmittal[]

  @@index([companyId, projectId, phaseId, deletedAt])
  @@index([companyId, projectId, wbsId, deletedAt])
  @@index([companyId, projectId, plannedStartDate, plannedEndDate])
  @@index([companyId, projectId, status, isCritical, deletedAt])
  @@map("project_tasks")
}

model ProjectWbs {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  projectId   String    @db.Uuid
  phaseId     String?   @db.Uuid
  parentId    String?   @db.Uuid
  code        String    @db.VarChar(50)
  name        String    @db.VarChar(200)
  description String?   @db.VarChar(2000)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  createdBy   String?   @db.Uuid
  updatedBy   String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(3)

  project            Project             @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Restrict)
  phase              ProjectPhase?       @relation(fields: [phaseId, companyId], references: [id, companyId], onDelete: Restrict)
  parent             ProjectWbs?         @relation("WbsHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children           ProjectWbs[]        @relation("WbsHierarchy")
  activities         ProjectTask[]
  qualityItps        QualityItp[]
  qualityInspections QualityInspection[]
  qualityNcrs        QualityNcr[]

  @@unique([id, companyId])
  @@index([companyId, projectId, parentId, sortOrder, deletedAt])
  @@index([companyId, projectId, code, deletedAt])
  @@map("project_wbs")
}

model ActivityDependency {
  id            String         @id @default(uuid()) @db.Uuid
  companyId     String         @db.Uuid
  projectId     String         @db.Uuid
  predecessorId String         @db.Uuid
  successorId   String         @db.Uuid
  type          DependencyType @default(FS)
  lagDays       Int            @default(0)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  createdBy     String?        @db.Uuid
  updatedBy     String?        @db.Uuid

  predecessor ProjectTask @relation("ActivityPredecessor", fields: [predecessorId], references: [id], onDelete: Restrict)
  successor   ProjectTask @relation("ActivitySuccessor", fields: [successorId], references: [id], onDelete: Restrict)

  @@unique([predecessorId, successorId, type])
  @@index([companyId, projectId, predecessorId])
  @@index([companyId, projectId, successorId])
  @@map("activity_dependencies")
}

model ProjectBaseline {
  id          String         @id @default(uuid()) @db.Uuid
  companyId   String         @db.Uuid
  projectId   String         @db.Uuid
  name        String         @db.VarChar(160)
  revision    Int
  status      BaselineStatus @default(DRAFT)
  description String?        @db.VarChar(1000)
  approvedAt  DateTime?      @db.Timestamptz(3)
  approvedBy  String?        @db.Uuid
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)
  createdBy   String?        @db.Uuid
  updatedBy   String?        @db.Uuid
  deletedAt   DateTime?      @db.Timestamptz(3)

  project    Project            @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Restrict)
  activities BaselineActivity[]

  @@unique([projectId, revision])
  @@index([companyId, projectId, status, deletedAt])
  @@map("project_baselines")
}

model BaselineActivity {
  id            String    @id @default(uuid()) @db.Uuid
  baselineId    String    @db.Uuid
  activityId    String    @db.Uuid
  plannedStart  DateTime? @db.Date
  plannedFinish DateTime? @db.Date
  durationDays  Int
  progress      Decimal   @default(0) @db.Decimal(5, 2)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  baseline ProjectBaseline @relation(fields: [baselineId], references: [id], onDelete: Restrict)
  activity ProjectTask     @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@unique([baselineId, activityId])
  @@index([activityId])
  @@map("baseline_activities")
}

model ActivityProgress {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @db.Uuid
  projectId         String   @db.Uuid
  activityId        String   @db.Uuid
  progressDate      DateTime @db.Date
  percentComplete   Decimal  @db.Decimal(5, 2)
  actualQuantity    Decimal? @db.Decimal(18, 4)
  remainingQuantity Decimal? @db.Decimal(18, 4)
  notes             String?  @db.VarChar(2000)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  createdBy         String?  @db.Uuid

  activity ProjectTask @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@index([companyId, projectId, activityId, progressDate])
  @@map("activity_progress")
}

// -----------------------------------------------------------------------------
// WORKFORCE & IDENTITY
// -----------------------------------------------------------------------------

model Employee {
  id                           String               @id @default(uuid()) @db.Uuid
  companyId                    String               @db.Uuid
  userId                       String?              @db.Uuid
  membershipId                 String?              @unique @db.Uuid
  employeeCode                 String               @db.VarChar(50)
  firstName                    String               @db.VarChar(100)
  middleName                   String?              @db.VarChar(100)
  lastName                     String               @db.VarChar(100)
  preferredName                String?              @db.VarChar(100)
  gender                       Gender               @default(UNDISCLOSED)
  dateOfBirth                  DateTime?            @db.Date
  nationalId                   String?              @db.VarChar(100)
  passportNumber               String?              @db.VarChar(100)
  nationality                  String?              @db.VarChar(100)
  religion                     String?              @db.VarChar(100)
  maritalStatus                MaritalStatus        @default(UNDISCLOSED)
  bloodGroup                   String?              @db.VarChar(10)
  phone                        String?              @db.VarChar(32)
  emergencyContactName         String?              @db.VarChar(160)
  emergencyContactPhone        String?              @db.VarChar(32)
  emergencyContactRelationship String?              @db.VarChar(100)
  personalEmail                String?              @db.VarChar(320)
  companyEmail                 String?              @db.VarChar(320)
  photoUrl                     String?              @db.VarChar(2048)
  signatureUrl                 String?              @db.VarChar(2048)
  status                       EmployeeStatus       @default(ACTIVE)
  availability                 EmployeeAvailability @default(AVAILABLE)
  branchId                     String?              @db.Uuid
  departmentId                 String?              @db.Uuid
  designationId                String?              @db.Uuid
  teamId                       String?              @db.Uuid
  managerEmployeeId            String?              @db.Uuid
  employmentTypeId             String?              @db.Uuid
  joiningDate                  DateTime             @db.Date
  confirmationDate             DateTime?            @db.Date
  resignationDate              DateTime?            @db.Date
  terminationDate              DateTime?            @db.Date
  createdAt                    DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime             @updatedAt @db.Timestamptz(3)
  createdBy                    String?              @db.Uuid
  updatedBy                    String?              @db.Uuid
  deletedAt                    DateTime?            @db.Timestamptz(3)

  company                  Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user                     User?                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  membership               CompanyMembership?          @relation(fields: [membershipId, companyId], references: [id, companyId], onDelete: Restrict)
  branch                   Branch?                     @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
  department               Department?                 @relation(fields: [departmentId, companyId], references: [id, companyId], onDelete: Restrict)
  designation              Designation?                @relation(fields: [designationId, companyId], references: [id, companyId], onDelete: Restrict)
  manager                  Employee?                   @relation("EmployeeManager", fields: [managerEmployeeId, companyId], references: [id, companyId], onDelete: Restrict)
  directReports            Employee[]                  @relation("EmployeeManager")
  employmentType           EmploymentType?             @relation(fields: [employmentTypeId], references: [id], onDelete: Restrict)
  employments              Employment[]                @relation("EmployeeEmployment")
  managedEmploymentRecords Employment[]                @relation("EmploymentManager")
  skills                   EmployeeSkill[]
  certifications           EmployeeCertification[]
  licenses                 EmployeeLicense[]
  documents                EmployeeDocument[]
  projectAssignments       EmployeeProjectAssignment[]
  teamMemberships          EmployeeTeamMembership[]

  @@unique([id, companyId])
  @@unique([membershipId, companyId])
  @@unique([companyId, employeeCode])
  @@unique([companyId, userId])
  @@unique([companyId, nationalId])
  @@index([companyId, status, availability, deletedAt])
  @@index([companyId, departmentId, designationId, deletedAt])
  @@index([companyId, firstName, lastName])
  @@index([companyId, companyEmail])
  @@map("employees")
}

model EmploymentType {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String?      @db.Uuid
  code        String       @db.VarChar(50)
  name        String       @db.VarChar(120)
  description String?      @db.VarChar(500)
  isSystem    Boolean      @default(false)
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  createdBy   String?      @db.Uuid
  updatedBy   String?      @db.Uuid
  deletedAt   DateTime?    @db.Timestamptz(3)

  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employees   Employee[]
  employments Employment[]

  @@index([companyId, code, deletedAt])
  @@map("employment_types")
}

model Employment {
  id                String           @id @default(uuid()) @db.Uuid
  companyId         String           @db.Uuid
  employeeId        String           @db.Uuid
  employmentTypeId  String           @db.Uuid
  branchId          String?          @db.Uuid
  departmentId      String?          @db.Uuid
  designationId     String?          @db.Uuid
  managerEmployeeId String?          @db.Uuid
  effectiveFrom     DateTime         @db.Date
  effectiveTo       DateTime?        @db.Date
  status            EmploymentStatus @default(ACTIVE)
  changeReason      String?          @db.VarChar(1000)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)
  createdBy         String?          @db.Uuid
  updatedBy         String?          @db.Uuid
  deletedAt         DateTime?        @db.Timestamptz(3)

  employee       Employee       @relation("EmployeeEmployment", fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  employmentType EmploymentType @relation(fields: [employmentTypeId], references: [id], onDelete: Restrict)
  branch         Branch?        @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
  department     Department?    @relation(fields: [departmentId, companyId], references: [id, companyId], onDelete: Restrict)
  designation    Designation?   @relation(fields: [designationId, companyId], references: [id, companyId], onDelete: Restrict)
  manager        Employee?      @relation("EmploymentManager", fields: [managerEmployeeId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, employeeId, effectiveFrom, effectiveTo])
  @@index([companyId, status, deletedAt])
  @@map("employments")
}

model WorkforceSkill {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String?      @db.Uuid
  code        String       @db.VarChar(50)
  name        String       @db.VarChar(120)
  description String?      @db.VarChar(500)
  isSystem    Boolean      @default(false)
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  createdBy   String?      @db.Uuid
  updatedBy   String?      @db.Uuid
  deletedAt   DateTime?    @db.Timestamptz(3)

  company   Company?        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employees EmployeeSkill[]

  @@index([companyId, code, deletedAt])
  @@map("workforce_skills")
}

model EmployeeSkill {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @db.Uuid
  employeeId       String    @db.Uuid
  skillId          String    @db.Uuid
  proficiencyLevel Int?      @db.SmallInt
  yearsExperience  Decimal?  @db.Decimal(5, 2)

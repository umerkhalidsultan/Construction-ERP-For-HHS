generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  INVITED
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum CompanyType {
  PRIVATE
  PUBLIC
  PARTNERSHIP
  SOLE_PROPRIETORSHIP
  NON_PROFIT
  GOVERNMENT
  OTHER
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum MeasurementSystem {
  METRIC
  IMPERIAL
}

enum DistanceUnit {
  MILLIMETER
  CENTIMETER
  METER
  KILOMETER
  INCH
  FOOT
  YARD
  MILE
}

enum TemperatureUnit {
  CELSIUS
  FAHRENHEIT
}

enum ThemeMode {
  LIGHT
  DARK
  SYSTEM
}

enum CostCenterType {
  PROJECT
  HEAD_OFFICE
  WAREHOUSE
  EQUIPMENT
  ADMINISTRATION
  OTHER
}

enum SequenceResetPolicy {
  NEVER
  YEARLY
  FISCAL_YEARLY
  MONTHLY
}

enum FilePurpose {
  COMPANY_LOGO
  FAVICON
  REPORT_HEADER
  REPORT_FOOTER
  EMAIL_LOGO
  WATERMARK
  PROFILE_PHOTO
  DOCUMENT
}

enum FileStatus {
  PENDING
  AVAILABLE
  QUARANTINED
  DELETED
}

enum VirusScanStatus {
  NOT_SCANNED
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectLifecycleStatus {
  DRAFT
  PLANNING
  TENDER
  AWARDED
  MOBILIZATION
  IN_PROGRESS
  ON_HOLD
  DELAYED
  COMPLETED
  CLOSED
  CANCELLED
  CUSTOM
}

enum ProjectContractType {
  LUMP_SUM
  UNIT_RATE
  COST_PLUS
  EPC
  DESIGN_BUILD
  TURNKEY
  REMEASUREMENT
  OTHER
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
  CANCELLED
}

enum PhaseStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum ActivityType {
  TASK
  SUMMARY
  MILESTONE
  LEVEL_OF_EFFORT
}

enum DependencyType {
  FS
  SS
  FF
  SF
}

enum BaselineStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

enum EmployeeStatus {
  ACTIVE
  PROBATION
  ON_LEAVE
  SUSPENDED
  RESIGNED
  TERMINATED
  INACTIVE
}

enum EmployeeAvailability {
  AVAILABLE
  ASSIGNED
  ON_LEAVE
  TRAINING
  SUSPENDED
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  UNDISCLOSED
}

enum EmploymentStatus {
  FUTURE
  ACTIVE
  SUSPENDED
  ENDED
}

enum EmployeeDocumentType {
  NATIONAL_ID
  PASSPORT
  VISA
  OFFER_LETTER
  EMPLOYMENT_CONTRACT
  EDUCATION_CERTIFICATE
  EXPERIENCE_CERTIFICATE
  MEDICAL_RECORD
  TRAINING_CERTIFICATE
  INSURANCE
  NDA
  OTHER
}

enum ProjectTeamRole {
  PROJECT_MANAGER
  SITE_ENGINEER
  QAQC_ENGINEER
  HSE_OFFICER
  PLANNING_ENGINEER
  PROCUREMENT_OFFICER
  STORE_KEEPER
  ACCOUNTANT
  SUBCONTRACTOR
  CONSULTANT
  CLIENT
  OTHER
}

enum ProjectDocumentCategory {
  CONTRACTS
  DRAWINGS
  BOQ
  SPECIFICATIONS
  SITE_PHOTOS
  APPROVALS
  INVOICES
  PERMITS
  INSPECTION_REPORTS
  CERTIFICATES
  OTHER
}

enum CalendarEventType {
  HOLIDAY
  MILESTONE
  MEETING
  INSPECTION
  DELIVERY
  WORKING_DAY_OVERRIDE
  OTHER
}

model Company {
  id                    String             @id @default(uuid()) @db.Uuid
  companyCode           String             @db.VarChar(32)
  legalName             String             @db.VarChar(255)
  displayName           String             @db.VarChar(160)
  logo                  String?            @db.VarChar(2048)
  email                 String?            @db.VarChar(320)
  phone                 String?            @db.VarChar(32)
  website               String?            @db.VarChar(2048)
  industry              String?            @db.VarChar(120)
  companyType           CompanyType        @default(PRIVATE)
  taxRegistrationNumber String?            @db.VarChar(100)
  nationalTaxNumber     String?            @db.VarChar(100)
  registrationNumber    String?            @db.VarChar(100)
  currency              String             @default("USD") @db.Char(3)
  timezone              String             @default("UTC") @db.VarChar(64)
  country               String             @db.Char(2)
  province              String?            @db.VarChar(120)
  city                  String?            @db.VarChar(120)
  postalCode            String?            @db.VarChar(32)
  address               String?            @db.VarChar(500)
  status                CompanyStatus      @default(ACTIVE)
  subscriptionStatus    SubscriptionStatus @default(TRIAL)
  subscriptionPlan      String?            @db.VarChar(80)
  employeeLimit         Int?
  projectLimit          Int?
  storageLimit          BigInt?            @db.BigInt
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3)
  createdBy             String?            @db.Uuid
  updatedBy             String?            @db.Uuid
  deletedAt             DateTime?          @db.Timestamptz(3)

  settings          CompanySettings?
  branding          CompanyBranding?
  memberships       CompanyMembership[]
  roles             Role[]
  branches          Branch[]
  departments       Department[]
  designations      Designation[]
  businessUnits     BusinessUnit[]
  regions           Region[]
  costCenters       CostCenter[]
  teams             Team[]
  reportingLines    ReportingLine[]
  documentSequences DocumentSequence[]
  files             FileObject[]
  auditLogs         AuditLog[]
  projects          Project[]
  projectStatusDefinitions ProjectStatusDefinition[]
  projectTypeDefinitions   ProjectTypeDefinition[]
  projectTags       ProjectTag[]
  employees         Employee[]
  employmentTypes   EmploymentType[]
  workforceSkills   WorkforceSkill[]

  @@index([status, deletedAt])
  @@index([displayName])
  @@map("companies")
}

model CompanySettings {
  id                   String            @id @default(uuid()) @db.Uuid
  companyId            String            @unique @db.Uuid
  workingDays          Weekday[]         @default([MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY])
  weekendDays          Weekday[]         @default([SATURDAY, SUNDAY])
  workingHoursStart    String            @default("08:00") @db.VarChar(5)
  workingHoursEnd      String            @default("17:00") @db.VarChar(5)
  fiscalYearName       String?           @db.VarChar(80)
  financialYearStart   String            @default("01-01") @db.VarChar(5)
  currency             String            @default("USD") @db.Char(3)
  dateFormat           String            @default("YYYY-MM-DD") @db.VarChar(32)
  timeFormat           String            @default("24h") @db.VarChar(8)
  measurementSystem    MeasurementSystem @default(METRIC)
  distanceUnit         DistanceUnit      @default(METER)
  temperatureUnit      TemperatureUnit   @default(CELSIUS)
  language             String            @default("en") @db.VarChar(16)
  defaultWarehouseId   String?           @db.Uuid
  autoNumberingEnabled Boolean           @default(true)
  documentPrefixes     Json              @default("{}")
  taxSettings          Json              @default("{}")
  approvalSettings     Json              @default("{}")
  emailSettings        Json              @default("{}")
  notificationSettings Json              @default("{}")
  projectDefaults      Json              @default("{}")
  attendanceRules      Json              @default("{}")
  payrollRules         Json              @default("{}")
  overtimeRules        Json              @default("{}")
  schemaVersion        Int               @default(1)
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(3)
  createdBy            String?           @db.Uuid
  updatedBy            String?           @db.Uuid
  deletedAt            DateTime?         @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, deletedAt])
  @@map("company_settings")
}

model CompanyBranding {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @unique @db.Uuid
  logoFileId        String?   @db.Uuid
  faviconFileId     String?   @db.Uuid
  reportHeaderFileId String?  @db.Uuid
  reportFooterFileId String?  @db.Uuid
  emailLogoFileId   String?   @db.Uuid
  watermarkFileId   String?   @db.Uuid
  primaryColor      String    @default("#0F766E") @db.VarChar(9)
  secondaryColor    String    @default("#0F172A") @db.VarChar(9)
  accentColor       String    @default("#F59E0B") @db.VarChar(9)
  theme             ThemeMode @default(LIGHT)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
  createdBy         String?   @db.Uuid
  updatedBy         String?   @db.Uuid
  deletedAt         DateTime? @db.Timestamptz(3)

  company      Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  logo         FileObject? @relation("BrandingLogo", fields: [logoFileId], references: [id], onDelete: SetNull)
  favicon      FileObject? @relation("BrandingFavicon", fields: [faviconFileId], references: [id], onDelete: SetNull)
  reportHeader FileObject? @relation("BrandingReportHeader", fields: [reportHeaderFileId], references: [id], onDelete: SetNull)
  reportFooter FileObject? @relation("BrandingReportFooter", fields: [reportFooterFileId], references: [id], onDelete: SetNull)
  emailLogo    FileObject? @relation("BrandingEmailLogo", fields: [emailLogoFileId], references: [id], onDelete: SetNull)
  watermark    FileObject? @relation("BrandingWatermark", fields: [watermarkFileId], references: [id], onDelete: SetNull)

  @@index([companyId, deletedAt])
  @@map("company_branding")
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  firstName     String     @db.VarChar(100)
  lastName      String     @db.VarChar(100)
  email         String     @unique @db.VarChar(320)
  phone         String?    @db.VarChar(32)
  password      String     @db.VarChar(255)
  profilePhoto  String?    @db.VarChar(2048)
  status        UserStatus @default(PENDING)
  isPlatformAdmin Boolean  @default(false)
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  mfaEnabled      Boolean    @default(false)
  mfaSecretEncrypted String? @db.VarChar(1000)
  lastLoginAt     DateTime?  @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)
  createdBy     String?    @db.Uuid
  updatedBy     String?    @db.Uuid
  deletedAt     DateTime?  @db.Timestamptz(3)

  memberships CompanyMembership[]
  sessions    Session[]
  auditLogs   AuditLog[]
  employees   Employee[]
  securityLogs UserSecurityLog[]

  @@index([status, deletedAt])
  @@map("users")
}

model CompanyMembership {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @db.Uuid
  userId          String           @db.Uuid
  employeeCode    String?          @db.VarChar(50)
  designationId   String?          @db.Uuid
  departmentId    String?          @db.Uuid
  branchId        String?          @db.Uuid
  teamId          String?          @db.Uuid
  status          MembershipStatus @default(INVITED)
  isCompanyOwner  Boolean          @default(false)
  joinedAt        DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  createdBy       String?          @db.Uuid
  updatedBy       String?          @db.Uuid
  deletedAt       DateTime?        @db.Timestamptz(3)

  company          Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user             User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  designation      Designation?   @relation(fields: [designationId, companyId], references: [id, companyId], onDelete: Restrict)
  department       Department?    @relation(fields: [departmentId, companyId], references: [id, companyId], onDelete: Restrict)
  branch           Branch?        @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict)
  team             Team?          @relation(fields: [teamId, companyId], references: [id, companyId], onDelete: Restrict)
  roles            MembershipRole[]
  managedBranches  Branch[]       @relation("BranchManager")
  headedDepartments Department[]  @relation("DepartmentHead")
  managedBusinessUnits BusinessUnit[] @relation("BusinessUnitManager")
  managedRegions   Region[]       @relation("RegionManager")
  managedCostCenters CostCenter[] @relation("CostCenterManager")
  ledTeams         Team[]         @relation("TeamLead")
  reportsTo        ReportingLine[] @relation("ReportingSubordinate")
  directReports    ReportingLine[] @relation("ReportingManager")
  managedProjects  Project[]      @relation("ProjectManager")
  siteEngineeredProjects Project[] @relation("ProjectSiteEngineer")
  projectTeamMemberships ProjectTeamMember[]
  assignedProjectTasks ProjectTask[] @relation("ProjectTaskAssignee")
  supervisedProjectTasks ProjectTask[] @relation("ProjectTaskSupervisor")
  employee Employee?

  @@unique([companyId, userId])
  @@unique([id, companyId])
  @@index([companyId, status, deletedAt])
  @@index([companyId, employeeCode])
  @@map("company_memberships")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String?   @db.Uuid
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(500)
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  createdBy   String?   @db.Uuid
  updatedBy   String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(3)

  company     Company?        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  memberships MembershipRole[]

  @@index([companyId, deletedAt])
  @@map("roles")
}

model Permission {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique @db.VarChar(120)
  subject     String    @db.VarChar(80)
  action      String    @db.VarChar(80)
  description String?   @db.VarChar(500)
  isSystem    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  createdBy   String?   @db.Uuid
  updatedBy   String?   @db.Uuid
  deletedAt   DateTime? @db.Timestamptz(3)

  roles RolePermission[]

  @@unique([subject, action])
  @@index([deletedAt])
  @@map("permissions")
}

model RolePermission {
  id           String    @id @default(uuid()) @db.Uuid
  roleId       String    @db.Uuid
  permissionId String    @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  createdBy    String?   @db.Uuid
  updatedBy    String?   @db.Uuid
  deletedAt    DateTime? @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  membershipId String    @db.Uuid
  roleId       String    @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  createdBy    String?   @db.Uuid
  updatedBy    String?   @db.Uuid
  deletedAt    DateTime? @db.Timestamptz(3)

  membership CompanyMembership @relation(fields: [membershipId, companyId], references: [id, companyId], onDelete: Restrict)
  role       Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([membershipId, roleId])
  @@index([companyId, deletedAt])
  @@map("membership_roles")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique @db.VarChar(255)
  expiresAt        DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  ipAddress        String?   @db.VarChar(64)
  userAgent        String?   @db.VarChar(1000)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  createdBy        String?   @db.Uuid
  updatedBy        String?   @db.Uuid
  deletedAt        DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model Branch {
  id                  String       @id @default(uuid()) @db.Uuid
  companyId           String       @db.Uuid
  branchCode          String       @db.VarChar(50)
  name                String       @db.VarChar(160)
  managerMembershipId String?      @db.Uuid
  businessUnitId      String?      @db.Uuid
  regionId            String?      @db.Uuid
  phone               String?      @db.VarChar(32)
  email               String?      @db.VarChar(320)
  address             String?      @db.VarChar(500)
  latitude            Decimal?     @db.Decimal(10, 7)
  longitude           Decimal?     @db.Decimal(10, 7)
  status              EntityStatus @default(ACTIVE)
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(3)
  createdBy           String?      @db.Uuid
  updatedBy           String?      @db.Uuid
  deletedAt           DateTime?    @db.Timestamptz(3)

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  manager      CompanyMembership? @relation("BranchManager", fields: [managerMembershipId, companyId], references: [id, companyId], onDelete: Restrict)
  businessUnit BusinessUnit?      @relation(fields: [businessUnitId, companyId], references: [id, companyId], onDelete: Restrict)
  region       Region?            @relation(fields: [regionId, companyId], references: [id, companyId], onDelete: Restrict)
  memberships CompanyMembership[]
  teams        Team[]
  sequences    DocumentSequence[]
  projects     Project[]
  employees    Employee[]
  employments  Employment[]

  @@unique([id, companyId])
  @@index([companyId, branchCode, deletedAt])
  @@index([companyId, status])
  @@map("branches")
}

model Department {
  id                  String       @id @default(uuid()) @db.Uuid
  companyId           String       @db.Uuid
  departmentCode      String       @db.VarChar(50)
  name                String       @db.VarChar(160)
  headMembershipId    String?      @db.Uuid
  parentDepartmentId  String?      @db.Uuid
  description         String?      @db.VarChar(1000)
  status              EntityStatus @default(ACTIVE)
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(3)
  createdBy           String?      @db.Uuid
  updatedBy           String?      @db.Uuid
  deletedAt           DateTime?    @db.Timestamptz(3)

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  head         CompanyMembership? @relation("DepartmentHead", fields: [headMembershipId, companyId], references: [id, companyId], onDelete: Restrict)
  parent       Department?        @relation("DepartmentTree", fields: [parentDepartmentId, companyId], references: [id, companyId], onDelete: Restrict)
  children     Department[]       @relation("DepartmentTree")
  memberships CompanyMembership[]
  teams        Team[]
  projects     Project[]
  employees    Employee[]
  employments  Employment[]

  @@unique([id, companyId])
  @@index([companyId, departmentCode, deletedAt])
  @@index([companyId, status])
  @@map("departments")
}

model Designation {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @db.Uuid
  code        String       @db.VarChar(50)
  name        String       @db.VarChar(160)
  description String?      @db.VarChar(1000)
  rank        Int?
  isDefault   Boolean      @default(false)
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  createdBy   String?      @db.Uuid
  updatedBy   String?      @db.Uuid
  deletedAt   DateTime?    @db.Timestamptz(3)

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  memberships CompanyMembership[]
  employees   Employee[]
  employments Employment[]

  @@unique([id, companyId])
  @@index([companyId, code, deletedAt])
  @@index([companyId, status])
  @@map("designations")
}

model BusinessUnit {
  id                  String       @id @default(uuid()) @db.Uuid
  companyId           String       @db.Uuid
  code                String       @db.VarChar(50)
  name                String       @db.VarChar(160)
  managerMembershipId String?      @db.Uuid
  description         String?      @db.VarChar(1000)
  status              EntityStatus @default(ACTIVE)
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(3)
  createdBy           String?      @db.Uuid
  updatedBy           String?      @db.Uuid
  deletedAt           DateTime?    @db.Timestamptz(3)

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  manager  CompanyMembership? @relation("BusinessUnitManager", fields: [managerMembershipId, companyId], references: [id, companyId], onDelete: Restrict)
  branches Branch[]

  @@unique([id, companyId])
  @@index([companyId, code, deletedAt])
  @@map("business_units")
}

model Region {
  id                  String       @id @default(uuid()) @db.Uuid
  companyId           String       @db.Uuid
  code                String       @db.VarChar(50)
  name                String       @db.VarChar(160)
  managerMembershipId String?      @db.Uuid
  description         String?      @db.VarChar(1000)
  status              EntityStatus @default(ACTIVE)
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(3)
  createdBy           String?      @db.Uuid
  updatedBy           String?      @db.Uuid
  deletedAt           DateTime?    @db.Timestamptz(3)

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  manager  CompanyMembership? @relation("RegionManager", fields: [managerMembershipId, companyId], references: [id, companyId], onDelete: Restrict)
  branches Branch[]

  @@unique([id, companyId])
  @@index([companyId, code, deletedAt])
  @@map("regions")
}

model CostCenter {
  id                  String         @id @default(uuid()) @db.Uuid
  companyId           String         @db.Uuid
  code                String         @db.VarChar(50)
  name                String         @db.VarChar(160)
  type                CostCenterType
  managerMembershipId String?        @db.Uuid
  parentCostCenterId  String?        @db.Uuid
  externalReferenceId String?        @db.Uuid
  description         String?        @db.VarChar(1000)
  status              EntityStatus   @default(ACTIVE)
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(3)
  createdBy           String?        @db.Uuid
  updatedBy           String?        @db.Uuid
  deletedAt           DateTime?      @db.Timestamptz(3)

